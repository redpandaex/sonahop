{
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "name": "sonahop-workspace",
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm --filter sonahop-ui tauri dev",
    "web:dev": "pnpm --filter sonahop-ui dev",
    "build": "pnpm --filter sonahop-ui build",
    "typecheck": "pnpm --filter sonahop-ui typecheck",
    "test": "pnpm --filter sonahop-ui test",
    "desktop:build": "pnpm --filter sonahop-ui tauri build --no-bundle",
    "android:init": "pnpm --filter sonahop-ui tauri android init --ci",
    "android:build": "pnpm --filter sonahop-ui tauri android build --debug --apk --target aarch64",
    "format": "pnpm --filter sonahop-ui format",
    "format:check": "pnpm --filter sonahop-ui format:check",
    "lint": "pnpm --filter sonahop-ui lint",
    "check": "pnpm --filter sonahop-ui check",
    "check:fix": "pnpm --filter sonahop-ui check:fix",
    "mvp:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-audio-mvp.ps1 -Platform Both",
    "mvp:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-audio-mvp.ps1 -Platform Windows",
    "mvp:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-audio-mvp.ps1 -Platform Android"
  },
  "private": true
}
